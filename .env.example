# Names and descriptions only. Do not put live secrets in this file.
# Copy to .env.local for local development. .env.local is gitignored.

# Runtime label used by Next.js. development | test | production
NODE_ENV=development

# Lowest log level written to stdout. debug | info | warn | error
LOG_LEVEL=info

# Non-production PostgreSQL connection string for Prisma.
# Local docker-compose example:
# DATABASE_URL=postgresql://aspera_dev:aspera_dev_only_not_secret@127.0.0.1:5432/aspera_marketplace_dev?schema=public
# Never point a local file at production. Never commit a real password.
DATABASE_URL=

# Local filesystem root for KYC document uploads. Defaults to ./uploads/kyc
DOCUMENT_STORAGE_PATH=

# HMAC secret for the mock payment webhook. Development-only fictional value.
MOCK_PAYMENT_WEBHOOK_SECRET=aspera-mock-webhook-dev-only-not-secret

# Reserved provider names. Leave unset until that slice exists.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_PROVIDER_API_KEY=
