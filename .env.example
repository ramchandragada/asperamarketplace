# Names and descriptions only. Do not put live secrets in this file.
# Copy to .env.local for local development. .env.local is gitignored.

# Do not set NODE_ENV here. Next.js sets it automatically
# (development for `next dev`, production for `next build`).
# A manual NODE_ENV=development breaks production builds (/_global-error).

# Lowest log level written to stdout. debug | info | warn | error
LOG_LEVEL=info

# Non-production PostgreSQL connection string for Prisma.
# Local docker-compose example:
# DATABASE_URL=postgresql://aspera_dev:aspera_dev_only_not_secret@127.0.0.1:5432/aspera_marketplace_dev?schema=public
# Never point a local file at production. Never commit a real password.
DATABASE_URL=

# Local filesystem root for KYC document uploads. Defaults to ./uploads/kyc
DOCUMENT_STORAGE_PATH=

# --- Legal imprint (defaults match Aspera Technologies Pvt Ltd GST records) ---
# SITE_LEGAL_ENTITY is not used for the wrong "Marketplace Private Limited" name.
# SITE_SUPPORT_EMAIL=support@asperamarketplace.com
# SITE_SUPPORT_PHONE=+91 80 4680 1200
# SITE_SUPPORT_PHONE_TEL=+918046801200
# SITE_GRIEVANCE_EMAIL=grievance@asperamarketplace.com
# SITE_GRIEVANCE_OFFICER_NAME=  # set the appointed person's legal name
# SITE_GRIEVANCE_OFFICER_TITLE=Grievance Officer
# SITE_GRIEVANCE_PHONE=+91 80 4680 1200
# SITE_GRIEVANCE_PHONE_TEL=+918046801200

# --- Payments ---
# Feature flags
# PAYMENTS_LIVE=false
# TCS_ENABLED=true

# Development mock webhook HMAC (never use in production once Razorpay is live).
MOCK_PAYMENT_WEBHOOK_SECRET=aspera-mock-webhook-dev-only-not-secret

# Active payment provider: mock | razorpay | cashfree
# PAYMENT_PROVIDER=mock

# Production-only: allow authenticated mock self-pay (POST /api/payments/mock-complete).
# Unset the moment a real payment provider goes live.
# ALLOW_MOCK_SELF_PAY=true

# Razorpay (live keys only when PAYMENTS_LIVE=true and NODE_ENV=production)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Cashfree (alternative gateway)
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=

# --- TCS (CGST Act s.52) — rates in basis points; 50 = 0.5% ---
# TCS_CGST_BPS=50
# TCS_SGST_BPS=50
# TCS_IGST_BPS=100
# TCS_GSTIN=27AAXCA0147N1CF
# ASPERA_REGULAR_GSTIN=27AAXCA0147N1Z4

# Require admin TOTP in production once ops is ready for 2FA login.
# ENABLE_ADMIN_TOTP=true

# Reserved integrations. Leave unset until that slice exists.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_PROVIDER_API_KEY=
