generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Append-only privileged action history. Rows are never updated or deleted by application code.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id")
  action        String
  targetType    String   @map("target_type")
  targetId      String?  @map("target_id")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  reason        String?
  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Command deduplication for money, stock, and other mutating operations.
model IdempotencyRecord {
  id           String    @id @default(uuid()) @db.Uuid
  key          String
  scope        String
  requestHash  String    @map("request_hash")
  responseCode String?   @map("response_code")
  responseBody Json?     @map("response_body")
  status       String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)

  @@unique([key, scope])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Domain events written in the same transaction as the state change, published asynchronously.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  enabled     Boolean  @default(false)
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

enum UserStatus {
  active
  suspended
  deleted
}

enum SellerStatus {
  draft
  submitted
  under_review
  approved
  rejected
  suspended
}

enum KycCaseStatus {
  open
  complete
  rejected
}

enum KycStage {
  business_profile
  documents
  agreement
  risk_screening
  manual_review
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  status          UserStatus @default(active)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles             UserRole[]
  sessions          Session[]
  ownedSellers      Seller[]           @relation("SellerOwner")
  reviewedSellers   Seller[]           @relation("SellerReviewer")
  uploadedDocuments KycDocument[]
  reviewedProducts  Product[]          @relation("ProductReviewer")
  carts             Cart[]
  addresses         CustomerAddress[]
  checkoutSessions  CheckoutSession[]
  orders            Order[]
  paymentAttempts   PaymentAttempt[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  /// "global" for platform roles, or the seller UUID for seller-scoped roles.
  scopeKey  String   @default("global") @map("scope_key")
  sellerId  String?  @map("seller_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  seller Seller? @relation(fields: [sellerId], references: [id])

  @@unique([userId, roleId, scopeKey])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@map("login_attempts")
}

model Seller {
  id                String       @id @default(uuid()) @db.Uuid
  ownerUserId       String       @map("owner_user_id") @db.Uuid
  legalName         String       @map("legal_name")
  tradeName         String?      @map("trade_name")
  status            SellerStatus
  statusReason      String?      @map("status_reason")
  contactEmail      String       @map("contact_email")
  contactPhone      String?      @map("contact_phone")
  panLast4          String?      @map("pan_last4")
  gstinMasked       String?      @map("gstin_masked")
  registeredState   String?      @map("registered_state")
  agreementAcceptedAt DateTime?  @map("agreement_accepted_at") @db.Timestamptz(6)
  submittedAt       DateTime?    @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId  String?      @map("reviewed_by_user_id") @db.Uuid
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int          @default(1)

  owner       User            @relation("SellerOwner", fields: [ownerUserId], references: [id])
  reviewer    User?           @relation("SellerReviewer", fields: [reviewedByUserId], references: [id])
  kycCases    SellerKycCase[]
  documents   KycDocument[]
  userRoles   UserRole[]
  products    Product[]
  inventory   InventoryItem[]
  fulfilmentGroups OrderFulfilmentGroup[]

  @@index([status])
  @@index([ownerUserId])
  @@map("sellers")
}

model SellerKycCase {
  id        String        @id @default(uuid()) @db.Uuid
  sellerId  String        @map("seller_id") @db.Uuid
  stage     KycStage
  status    KycCaseStatus
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller    Seller        @relation(fields: [sellerId], references: [id])
  documents KycDocument[]

  @@index([sellerId])
  @@map("seller_kyc_cases")
}

model KycDocument {
  id               String   @id @default(uuid()) @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  kycCaseId        String   @map("kyc_case_id") @db.Uuid
  documentType     String   @map("document_type")
  storageKey       String   @map("storage_key")
  fileName         String   @map("file_name")
  contentType      String   @map("content_type")
  byteSize         Int      @map("byte_size")
  checksumSha256   String   @map("checksum_sha256")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  seller   Seller        @relation(fields: [sellerId], references: [id])
  kycCase  SellerKycCase @relation(fields: [kycCaseId], references: [id])
  uploader User          @relation(fields: [uploadedByUserId], references: [id])

  @@index([sellerId])
  @@map("kyc_documents")
}

enum ProductStatus {
  draft
  submitted
  approved
  rejected
  archived
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique
  name        String
  description String?
  parentId    String?    @map("parent_id") @db.Uuid
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  sellerId         String        @map("seller_id") @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  brandId          String?       @map("brand_id") @db.Uuid
  slug             String        @unique
  title            String
  summary          String
  description      String
  status           ProductStatus
  statusReason     String?       @map("status_reason")
  countryOfOrigin  String?       @map("country_of_origin")
  hsnCode          String?       @map("hsn_code")
  attributes       Json?
  searchDocument   String        @default("") @map("search_document")
  submittedAt      DateTime?     @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId String?       @map("reviewed_by_user_id") @db.Uuid
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int           @default(1)

  seller    Seller           @relation(fields: [sellerId], references: [id])
  category  Category         @relation(fields: [categoryId], references: [id])
  brand     Brand?           @relation(fields: [brandId], references: [id])
  reviewer  User?            @relation("ProductReviewer", fields: [reviewedByUserId], references: [id])
  variants  ProductVariant[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  sku               String   @unique
  title             String
  optionValues      Json?    @map("option_values")
  mrpPaise          Int      @map("mrp_paise")
  sellingPricePaise Int      @map("selling_price_paise")
  currencyCode      String   @default("INR") @map("currency_code")
  weightGrams       Int?     @map("weight_grams")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product        @relation(fields: [productId], references: [id])
  inventory InventoryItem?
  cartItems CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model InventoryItem {
  id        String   @id @default(uuid()) @db.Uuid
  variantId String   @unique @map("variant_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  damaged   Int      @default(0)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant   ProductVariant  @relation(fields: [variantId], references: [id])
  seller    Seller          @relation(fields: [sellerId], references: [id])
  movements StockMovement[]

  @@map("inventory_items")
}

model StockMovement {
  id              String   @id @default(uuid()) @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  movementType    String   @map("movement_type")
  quantity        Int
  reason          String
  actorId         String?  @map("actor_id")
  correlationId   String   @map("correlation_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@map("stock_movements")
}

enum CartStatus {
  open
  checked_out
  abandoned
}

enum CheckoutStatus {
  draft
  reserved
  expired
  cancelled
  converted
}

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  status       CartStatus @default(open)
  currencyCode String     @default("INR") @map("currency_code")
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id])
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String   @default("Home")
  fullName   String   @map("full_name")
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String   @default("IN")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id])
  checkoutSessions CheckoutSession[]
  orders           Order[]

  @@index([userId])
  @@map("customer_addresses")
}

model CheckoutSession {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  cartId             String         @map("cart_id") @db.Uuid
  addressId          String         @map("address_id") @db.Uuid
  status             CheckoutStatus @default(draft)
  currencyCode       String         @default("INR") @map("currency_code")
  couponCode         String?        @map("coupon_code")
  /// Server-owned calculation snapshot. Browser totals are never authoritative.
  snapshot           Json
  subtotalPaise      Int            @map("subtotal_paise")
  discountPaise      Int            @default(0) @map("discount_paise")
  shippingPaise      Int            @default(0) @map("shipping_paise")
  taxPaise           Int            @default(0) @map("tax_paise")
  totalPaise         Int            @map("total_paise")
  reservedUntil      DateTime?      @map("reserved_until") @db.Timestamptz(6)
  idempotencyKey     String?        @unique @map("idempotency_key")
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User            @relation(fields: [userId], references: [id])
  cart    Cart            @relation(fields: [cartId], references: [id])
  address CustomerAddress @relation(fields: [addressId], references: [id])
  order   Order?

  @@index([userId, status])
  @@index([cartId])
  @@map("checkout_sessions")
}

enum OrderStatus {
  awaiting_payment
  paid
  payment_failed
  cancelled
  partially_cancelled
  fulfilled
}

enum FulfilmentGroupStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentAttemptStatus {
  created
  pending
  succeeded
  failed
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  voided
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderNumber       String      @unique @map("order_number")
  userId            String      @map("user_id") @db.Uuid
  checkoutSessionId String      @unique @map("checkout_session_id") @db.Uuid
  addressId         String      @map("address_id") @db.Uuid
  status            OrderStatus
  currencyCode      String      @default("INR") @map("currency_code")
  snapshot          Json
  subtotalPaise     Int         @map("subtotal_paise")
  discountPaise     Int         @default(0) @map("discount_paise")
  shippingPaise     Int         @default(0) @map("shipping_paise")
  taxPaise          Int         @default(0) @map("tax_paise")
  totalPaise        Int         @map("total_paise")
  statusReason      String?     @map("status_reason")
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(6)
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                   @relation(fields: [userId], references: [id])
  checkoutSession CheckoutSession        @relation(fields: [checkoutSessionId], references: [id])
  address         CustomerAddress        @relation(fields: [addressId], references: [id])
  lines           OrderLine[]
  groups          OrderFulfilmentGroup[]
  payments        PaymentAttempt[]
  invoices        Invoice[]
  returnRequests  ReturnRequest[]
  refunds         Refund[]
  tickets         SupportTicket[]
  disputes        Dispute[]

  @@index([userId, status])
  @@index([status])
  @@map("orders")
}

model OrderFulfilmentGroup {
  id             String                @id @default(uuid()) @db.Uuid
  orderId        String                @map("order_id") @db.Uuid
  sellerId       String                @map("seller_id") @db.Uuid
  status         FulfilmentGroupStatus @default(pending)
  lineTotalPaise Int                   @map("line_total_paise")
  shippingPaise  Int                   @default(0) @map("shipping_paise")
  statusReason   String?               @map("status_reason")
  carrier        String?
  trackingNumber String?               @map("tracking_number")
  trackingUrl    String?               @map("tracking_url")
  shippedAt      DateTime?             @map("shipped_at") @db.Timestamptz(6)
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(6)
  cancelledAt    DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order       @relation(fields: [orderId], references: [id])
  seller   Seller      @relation(fields: [sellerId], references: [id])
  lines    OrderLine[]
  shipment Shipment?
  settlementLines SettlementLine[]

  @@index([orderId])
  @@index([sellerId, status])
  @@map("order_fulfilment_groups")
}

model OrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  fulfilmentGroupId String   @map("fulfilment_group_id") @db.Uuid
  sellerId          String   @map("seller_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  productTitle      String   @map("product_title")
  variantTitle      String   @map("variant_title")
  sku               String
  quantity          Int
  unitPricePaise    Int      @map("unit_price_paise")
  lineTotalPaise    Int      @map("line_total_paise")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order           Order                @relation(fields: [orderId], references: [id])
  fulfilmentGroup OrderFulfilmentGroup @relation(fields: [fulfilmentGroupId], references: [id])

  @@index([orderId])
  @@index([fulfilmentGroupId])
  @@map("order_lines")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  provider          String               @default("mock")
  providerReference String               @unique @map("provider_reference")
  status            PaymentAttemptStatus
  amountPaise       Int                  @map("amount_paise")
  currencyCode      String               @default("INR") @map("currency_code")
  clientSecret      String?              @map("client_secret")
  failureReason     String?              @map("failure_reason")
  idempotencyKey    String               @unique @map("idempotency_key")
  rawCreateResponse Json?                @map("raw_create_response")
  paidAt            DateTime?            @map("paid_at") @db.Timestamptz(6)
  failedAt          DateTime?            @map("failed_at") @db.Timestamptz(6)
  version           Int                  @default(1)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order                 @relation(fields: [orderId], references: [id])
  user     User                  @relation(fields: [userId], references: [id])
  webhooks PaymentWebhookEvent[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id               String   @id @default(uuid()) @db.Uuid
  provider         String
  providerEventId  String   @map("provider_event_id")
  paymentAttemptId String?  @map("payment_attempt_id") @db.Uuid
  eventType        String   @map("event_type")
  payloadHash      String   @map("payload_hash")
  signatureValid   Boolean  @map("signature_valid")
  processed        Boolean  @default(false)
  processingError  String?  @map("processing_error")
  rawPayload       Json     @map("raw_payload")
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])

  @@unique([provider, providerEventId])
  @@index([paymentAttemptId])
  @@map("payment_webhook_events")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  invoiceNumber String        @unique @map("invoice_number")
  status        InvoiceStatus @default(draft)
  currencyCode  String        @default("INR") @map("currency_code")
  totalPaise    Int           @map("total_paise")
  /// Structured invoice body. Not a legally reviewed tax invoice (A-21/A-24 open).
  document      Json
  storageKey    String?       @map("storage_key")
  issuedAt      DateTime?     @map("issued_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("invoices")
}

model NotificationMessage {
  id           String   @id @default(uuid()) @db.Uuid
  channel      String
  recipient    String
  templateKey  String   @map("template_key")
  payload      Json
  status       String   @default("pending")
  providerRef  String?  @map("provider_ref")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("notification_messages")
}

enum ReturnStatus {
